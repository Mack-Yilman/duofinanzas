# Copia este archivo a .env.local y completa los valores.

# Supabase → Project Settings → API (la anon key es pública; la protege RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Subruta de GitHub Pages (vacío en local)
NEXT_PUBLIC_BASE_PATH=

# ── Solo para el script de migración desde Notion (NUNCA en el repo ni en CI) ──
SUPABASE_SERVICE_ROLE_KEY=
NOTION_TOKEN=
USERS_DB_ID=
COUPLES_DB_ID=
EXPENSES_DB_ID=
INCOMES_DB_ID=
GOALS_DB_ID=
CATEGORIES_DB_ID=
GOALS_CONTRIBUTIONS_DB_ID=
